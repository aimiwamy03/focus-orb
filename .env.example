# NextAuth Configuration
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# AUTH_SECRET and AUTH_URL also work (NextAuth v5 names).
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
# Get these from Google Cloud Console OAuth 2.0 Client
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET also work.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public flag to show/hide Google button (set to 'true' when configured)
NEXT_PUBLIC_GOOGLE_CONFIGURED=false

# WHOOP (optional, server-only). Amy already set these in Vercel Production.
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=
# Comma-separated Google emails allowed to connect WHOOP. Case-insensitive, max 10.
# Empty or unset means nobody can connect. They see: WHOOP is invite-only during beta.
# WHOOP_INVITE_EMAILS=aimiw.amy03@gmail.com

# Voice (optional, server-only). Never prefix with NEXT_PUBLIC_.
# ASSEMBLYAI_API_KEY=
# POSTHOG_KEY=
# POSTHOG_HOST=
